# Silente web on nomadservernw. Copy to /srv/nomad/silente/.env (chmod 600).
# There are no secrets: the site is static and public.
#
# Check against the server values:
#   grep -E 'DOMINIO_PUBLICO|DOCKER_RED_PROXY=' ~/nomad_server/config/servidor.env

# Public host (spec L-01). Traefik routes it to this container.
APP_HOST=silente.nordirwork.com

# Shared Traefik network (DOCKER_RED_PROXY).
PROXY_NETWORK=nomadservernw_proxy
